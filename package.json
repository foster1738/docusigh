{
  "name": "@docusigh/email",
  "version": "0.1.0",
  "description": "Bulletproof transactional email sender: durable outbox, retries with jittered backoff, provider fallback, circuit breakers, rate limiting, idempotency, dead-lettering, and bounce suppression.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/store/schema.sql"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "example": "tsx examples/basic.ts",
    "build:browser": "esbuild src/browser.ts --bundle --format=iife --global-name=Bulletproof --outfile=docs/app.bundle.js --minify",
    "example:bulk": "tsx examples/bulk.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
